{
  "name": "duplicate-clear",
  "productName": "DuplicateClear",
  "version": "1.0.0",
  "description": "Open Source Duplicate File Finder - Fast duplicate detection powered by hashing",
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite && electron .",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "build:electron": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win --publish never",
    "build:portable": "vite build && electron-builder --win portable --publish never",
    "preview": "vite preview",
    "electron": "electron .",
    "release": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@types/spark-md5": "^3.0.5",
    "browser-image-hash": "^0.0.7",
    "chart.js": "^4.5.1",
    "clsx": "2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "music-metadata-browser": "^2.5.11",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-electron": "^0.28.5",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.duplicateclear.app",
    "productName": "DuplicateClear",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DuplicateClear"
    },
    "portable": {
      "artifactName": "DuplicateClear-${version}-portable.exe"
    }
  }
}
